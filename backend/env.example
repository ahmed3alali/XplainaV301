# Copy to backend/.env — not committed

# Postgres (Supabase pooler URL — database only, no Supabase API keys)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Student JWT (issued by /auth/login)
JWT_SECRET_KEY=change-me-long-random-string

# Admin JWT (issued by /admin/login)
ADMIN_JWT_SECRET=change-me-another-long-random-string

# LLM (optional)
OPENROUTER_API_KEY=
MENTOR_OPENROUTER_API_KEY=
