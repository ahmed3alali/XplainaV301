# Local:  cp env.example .env.local
# Vercel:  Settings → Environment Variables → Redeploy after saving

# ── Backend (server-only — NOT exposed to browser) ───────────────────────────
# Local:
API_BASE=http://localhost:8000
# Production on Vercel:
# API_BASE=https://api.claripath.dev

# Browser calls /api/backend/* (proxy). Auth uses httpOnly JWT cookie — no Supabase keys.

# ── Demo logins ──────────────────────────────────────────────────────────────
# Admin:   admin@claripath.dev / Claripath@Admin1     → /admin/login
# Student: student@claripath.dev / Claripath@Student1 → /login
# Dataset: ID 2 / password test000                    → /login
